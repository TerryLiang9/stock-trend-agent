# A 股智能分析系统最小配置
# 复制为 .env 后填写真实值：Copy-Item .env.example .env

# ================================
# 1. A 股股票池
# ================================
# 主分析股票列表，使用 6 位 A 股代码，多个代码用逗号分隔。
STOCK_LIST=600519,000001,300750

# ================================
# 2. 大模型（至少配置一个）
# ================================
# 推荐使用 Anspire；也可使用任意 OpenAI 兼容服务。
# Anspire API Key，支持多个 Key 时用逗号分隔。
ANSPIRE_API_KEYS=
# OpenAI 兼容服务的 API Key；与 ANSPIRE_API_KEYS 二选一即可。
# OPENAI_API_KEY=
# OpenAI 兼容服务地址，例如 https://api.deepseek.com/v1。
# OPENAI_BASE_URL=https://api.openai.com/v1
# 使用的模型名称，必须与服务商支持的模型一致。
# OPENAI_MODEL=gpt-4o-mini
# Gemini API Key，可选。
# GEMINI_API_KEY=
# Anthropic API Key，可选。
# ANTHROPIC_API_KEY=

# ================================
# 3. A 股行情源（按需配置）
# ================================
# Tushare Pro Token；配置后可作为 A 股历史行情备用源。
# TUSHARE_TOKEN=
# TickFlow API Key；用于更稳定的 A 股行情和实时数据。
# TICKFLOW_API_KEY=

# ================================
# 4. A 股趋势 Agent
# ================================
# 是否启用趋势 Agent 定时任务；false 时只可通过 API/CLI 手动调用。
MA_AGENT_ENABLED=true
# 趋势 Agent 计划执行时间，使用中国时区 HH:MM。
MA_AGENT_SCHEDULE_TIME=15:10
# 趋势 Agent 需要分析的 A 股代码，建议带 .SH/.SZ/.BJ 后缀。
MA_AGENT_SYMBOLS=688311.SH

# 四个技术模型权重之和必须为 1；均线权重必须高于任一研究模型
MA_AGENT_WEIGHT_MOVING_AVERAGE=0.70
MA_AGENT_WEIGHT_WAVELET=0.10
MA_AGENT_WEIGHT_ANALOG=0.10
MA_AGENT_WEIGHT_LOGISTIC_6F=0.10

# 数据粒度：minute 使用分钟 K 线，tick 使用 Tick 聚合。
MA_AGENT_DATA_MODE=minute
# Tick 查询失败时是否允许降级到分钟表；false 可避免静默改变数据源。
MA_AGENT_ALLOW_MINUTE_FALLBACK=false
# ClickHouse 分钟/Tick 源失败时是否允许降级到日线源；结果会失去分钟内结构证据。
# 是否读取截止时间之前的新闻并参与多模型裁决。
MA_AGENT_NEWS_ENABLED=false

# 交易模式：disabled 禁止订单，paper 使用模拟盘，live 使用实盘 Broker。
MA_AGENT_TRADING_MODE=disabled
# 实盘二次确认开关；必须为 true 才允许 live 模式启动。
MA_AGENT_LIVE_CONFIRMED=false
# 急停开关；true 时拒绝新订单，只保留人工处理流程。
MA_AGENT_KILL_SWITCH=false
# 是否允许通过走步验证自动晋级 challenger 参数；建议先保持 false。
MA_AGENT_AUTO_PROMOTE=false
# 参数晋级所需的最少已评估样本数。
MA_AGENT_MIN_EVALUATED_SAMPLES=60
# challenger 相对 champion 至少需要提升的命中率百分点。
MA_AGENT_MIN_IMPROVEMENT_PCT=3.0

# ================================
# 5. ClickHouse（趋势 Agent 使用）
# ================================
# ClickHouse 主机名或 IP 地址。
CLICKHOUSE_HOST=
# ClickHouse HTTP/HTTPS 端口，8443 通常对应 TLS，8123 通常对应非 TLS。
CLICKHOUSE_PORT=8443
# 趋势 Agent 使用的数据库名称，只能由服务端配置指定。
CLICKHOUSE_DATABASE=
# 只读 ClickHouse 用户名。
CLICKHOUSE_USER=readonly
# ClickHouse 密码；不要提交到 Git 或写入日志。
CLICKHOUSE_PASSWORD=
# 是否启用 TLS 连接；生产环境建议 true。
CLICKHOUSE_SECURE=true

# minute 模式必须配置；物理表需提供 symbol、datetime、OHLCV 字段。
CLICKHOUSE_MINUTE_TABLE=
# tick 模式必须配置；当前聚合模板默认读取 symbol/event_time/price/volume/amount/sequence。
CLICKHOUSE_TICK_TABLE=
# Tick 成交量语义：incremental 表示逐笔增量，cumulative 表示日内累计值。
CLICKHOUSE_TICK_VOLUME_SEMANTICS=incremental

# ================================
# 6. 服务与定时任务
# ================================
# 是否启用自动分析、自动趋势预测和 Bot 流；当前建议保持 false。
AUTOMATION_ENABLED=false
# 是否允许 NotificationService 向任何渠道发送消息；当前建议保持 false。
NOTIFICATIONS_ENABLED=false
# Web/API 监听地址；仅本机访问时使用 127.0.0.1。
HOST=127.0.0.1
# Web/API 监听端口。
PORT=8000
# 是否启用 Web UI。
WEBUI_ENABLED=false
# 是否启用项目原有的每日分析调度。
SCHEDULE_ENABLED=false
# 项目原有分析任务的执行时间，使用中国时区 HH:MM。
SCHEDULE_TIME=18:00
# 启动时是否立即执行一次分析任务。
RUN_IMMEDIATELY=true

# 报告语言：zh/en/ko；A 股项目建议使用 zh。
REPORT_LANGUAGE=zh
